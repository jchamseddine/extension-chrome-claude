{
  "manifest_version": 3,
  "name": "Claude Usage",
  "version": "1.0.0",
  "description": "Affiche l'usage de session (5h) et hebdomadaire (7j) de claude.ai, plus une estimation du contexte de la conversation en cours.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "notifications", "alarms", "scripting"],
  "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*", "https://status.claude.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["content.js", "context-estimator.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "exclude_matches": ["https://a.claude.ai/*"],
      "js": ["theme.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://a.claude.ai/*"],
      "js": ["theme.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["autocontinue-source.js", "autocontinue.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["folders-source.js", "folders.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["export-source.js", "export.js"],
      "run_at": "document_idle"
    }
  ]
}
